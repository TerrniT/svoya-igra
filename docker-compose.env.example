# Prod env for docker-compose.prod.yml (backend + caddy).
# Copy to docker-compose.env and set a real EMAIL for Let's Encrypt.

DOMAIN=repetly.ru
EMAIL=admin@repetly.ru

HOST=0.0.0.0
PORT=8080
WS_PATH=/ws
CORS_ORIGINS=https://repetly.ru,https://www.repetly.ru
JOIN_ORIGINS=https://repetly.ru
MAX_MESSAGE_BYTES=1048576
READ_TIMEOUT=60s
WRITE_TIMEOUT=8s
PING_INTERVAL=20s
